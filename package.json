{
  "name": "stifinder",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "Tracks down the shortest, least-surprising failure trace — budget-bounded, iteratively deepened state-space exploration for JavaScript.",
  "keywords": [
    "state space",
    "model checking",
    "exploration",
    "bfs",
    "iterative deepening",
    "concurrency testing",
    "deterministic simulation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/stifinder.git"
  },
  "bugs": "https://github.com/andershessellund/stifinder/issues",
  "homepage": "https://github.com/andershessellund/stifinder#readme",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "peerDependencies": {
    "valsem": ">=0.0.3 <1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@conventional-commits/parser": "0.4.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "valsem": "^0.0.4",
    "vitest": "^5.0.1"
  }
}
